{
  "name": "@cliat/meta-ai",
  "version": "0.3.12",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "publish": {
    "exclude": [
      ".agents/",
      ".auth/",
      ".claude/",
      ".playwright-cli/",
      "assets/",
      "bin/",
      "history/",
      "out/",
      "sess.json",
      "skills-lock.json"
    ]
  },
  "tasks": {
    "run": "deno run -A cli.ts",
    "check": "deno check cli.ts mod.ts",
    "version": "deno run -A ./scripts/version.ts current",
    "version:compare": "deno run -A ./scripts/version.ts compare",
    "version:github-output": "deno run -A ./scripts/version.ts github-output",
    "fmt": "deno fmt",
    "publish:dry-run": "deno publish --dry-run",
    "publish": "deno publish",
    "compile": "deno task compile:linux-x86_64 && deno task compile:linux-aarch64 && deno task compile:windows-x86_64 && deno task compile:darwin-x86_64 && deno task compile:darwin-aarch64",
    "compile:linux-x86_64": "deno compile -A --target x86_64-unknown-linux-gnu -o ./bin/meta-ai-x86_64-unknown-linux-gnu cli.ts",
    "compile:linux-aarch64": "deno compile -A --target aarch64-unknown-linux-gnu -o ./bin/meta-ai-aarch64-unknown-linux-gnu cli.ts",
    "compile:windows-x86_64": "deno compile -A --target x86_64-pc-windows-msvc -o ./bin/meta-ai-x86_64-pc-windows-msvc.exe cli.ts",
    "compile:darwin-x86_64": "deno compile -A --target x86_64-apple-darwin -o ./bin/meta-ai-x86_64-apple-darwin cli.ts",
    "compile:darwin-aarch64": "deno compile -A --target aarch64-apple-darwin -o ./bin/meta-ai-aarch64-apple-darwin cli.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@std/path": "jsr:@std/path@^1.1.2"
  }
}
