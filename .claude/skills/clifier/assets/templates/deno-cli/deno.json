{
  "name": "@your-scope/your-tool",
  "version": "0.1.0",
  "license": "MIT",
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0"
  },
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "tasks": {
    "run": "deno run -A cli.ts",
    "check": "deno check cli.ts mod.ts",
    "version": "deno run -A ./scripts/version.ts current",
    "version:compare": "deno run -A ./scripts/version.ts compare",
    "version:github-output": "deno run -A ./scripts/version.ts github-output",
    "publish:dry-run": "deno publish --dry-run",
    "publish": "deno publish",
    "compile": "deno task compile:linux-x64 && deno task compile:linux-arm64 && deno task compile:windows-x64 && deno task compile:macos-x64 && deno task compile:macos-arm64",
    "compile:linux-x64": "deno compile -A --target x86_64-unknown-linux-gnu -o ./bin/tool-x86_64-unknown-linux-gnu cli.ts",
    "compile:linux-arm64": "deno compile -A --target aarch64-unknown-linux-gnu -o ./bin/tool-aarch64-unknown-linux-gnu cli.ts",
    "compile:windows-x64": "deno compile -A --target x86_64-pc-windows-msvc -o ./bin/tool-x86_64-pc-windows-msvc.exe cli.ts",
    "compile:macos-x64": "deno compile -A --target x86_64-apple-darwin -o ./bin/tool-x86_64-apple-darwin cli.ts",
    "compile:macos-arm64": "deno compile -A --target aarch64-apple-darwin -o ./bin/tool-aarch64-apple-darwin cli.ts"
  }
}
